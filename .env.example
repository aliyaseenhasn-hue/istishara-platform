# LawConnect - Environment Variables Template
# Copy this file to .env and fill in the actual values from Supabase Dashboard

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Digits only, including country code. Pass with --dart-define because contact
# information is embedded into release builds rather than loaded as a secret.
SUPPORT_WHATSAPP=
